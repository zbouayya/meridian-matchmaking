# Copy this file to `.env` and fill it in. `.env` is git-ignored and is never copied into
# the Docker image; pass it at run time with `docker run --env-file .env …`.
# A variable already set in the environment wins over this file.

# Claude API key (console.anthropic.com). Billed separately from a Claude subscription.
ANTHROPIC_API_KEY=

# The two models the case compares. These are the defaults.
# MATCHMAKER_STRONG_MODEL=claude-opus-5-5
# MATCHMAKER_WEAK_MODEL=claude-haiku-5-5
